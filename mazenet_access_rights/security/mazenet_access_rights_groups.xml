            <field name="privilege_id" ref="res_groups_privilege_mzr_lms"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_lms_atl')),
                                            (4, ref('group_mzr_lms_tl_direct_agent')),]"/>
            <field name="comment">Team Lead on the LMS team only. Supervises ATL-1/ATL-2 plus any directly-assigned agents ("TL-direct"). Reports into the single, shared Corporate BU Manager.</field>
        </record>

        <!-- TNH -->
        <record id="module_category_mzr_tnh" model="ir.module.category">
            <field name="name">Mazenet Access Rights: TNH</field>
            <field name="description">Isolated access hierarchy for the TNH team (Corporate BU) only.</field>
            <field name="sequence">90</field>
        </record>
        <record id="res_groups_privilege_mzr_tnh" model="res.groups.privilege">
            <field name="name">TNH Role</field>
            <field name="category_id" ref="module_category_mzr_tnh"/>
            <field name="sequence">1</field>
        </record>
        <record id="group_mzr_tnh_agent" model="res.groups">
            <field name="name">TNH: Agent</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_tnh"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">ATL-supervised front-line agent on the TNH team only. No visibility into other teams.</field>
        </record>
        <record id="group_mzr_tnh_atl" model="res.groups">
            <field name="name">TNH: ATL</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_tnh"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_tnh_agent'))]"/>
            <field name="comment">Assistant Team Lead on the TNH team only (ATL-1 / ATL-2 in the org chart). Supervises a small group of agents.</field>
        </record>
        <record id="group_mzr_tnh_tl_direct_agent" model="res.groups">
            <field name="name">TNH: TL-Direct Agent</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_tnh"/>
            <field name="comment">This is the TL-Direct Agent group for the TNH team.</field>
        </record>
        <record id="group_mzr_tnh_tl" model="res.groups">
            <field name="name">TNH: Team Lead</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_tnh"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_tnh_atl')),
                                            (4, ref('group_mzr_tnh_tl_direct_agent')),]"/>
            <field name="comment">Team Lead on the TNH team only. Supervises ATL-1/ATL-2 plus any directly-assigned agents ("TL-direct"). Reports into the single, shared Corporate BU Manager.</field>
        </record>

        <!-- =================================================================
             Corporate BU Manager - ONE group, shared across all 5 Corporate
             teams above (Hunter, Account Manager, Corporate Training, LMS,
             TNH), unlike DMT/Technology/software/MIS where each team has
             its own separate BU Manager. This is the intentional exception:
             "Corporate BU manager - Shared across 5 groups" in the org
             chart.
        ================================================================== -->
        <record id="module_category_mzr_corporate" model="ir.module.category">
            <field name="name">Mazenet Access Rights: Corporate</field>
            <field name="description">The single BU Manager shared across Hunter, Account Manager, Corporate Training, LMS and TNH.</field>
            <field name="sequence">45</field>
        </record>
        <record id="res_groups_privilege_mzr_corporate" model="res.groups.privilege">
            <field name="name">Corporate Role</field>
            <field name="category_id" ref="module_category_mzr_corporate"/>
            <field name="sequence">1</field>
        </record>
        <record id="group_mzr_corporate_manager_direct_agent" model="res.groups">
            <field name="name">Corporate: Manager-Direct Agent</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_corporate"/>
            <field name="comment">This is the Manager-Direct Agent group for the Corporate BU Manager.</field>
        </record>
        <record id="group_mzr_corporate_manager" model="res.groups">
            <field name="name">Corporate: BU Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_corporate"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_hunter_tl')),
                                            (4, ref('group_mzr_account_manager_tl')),
                                            (4, ref('group_mzr_corporate_training_tl')),
                                            (4, ref('group_mzr_lms_tl')),
                                            (4, ref('group_mzr_tnh_tl')),
                                            (4, ref('group_mzr_corporate_manager_direct_agent')),]"/>
            <field name="comment">Shared across all 5 Corporate teams (Hunter, Account Manager, Corporate Training, LMS, TNH) - one Manager, not duplicated per team. Implied by the global CTO/Admin group.</field>
        </record>

        <!-- =================================================================
             Global roles - shared across ALL FOUR teams (unlike the
             team-specific groups above). These are the only two groups in
             this module that cross team boundaries, matching the reference
             org chart where CTO/admin ("All access") and MD ("Read-only,
             all teams") sit above every team, connected to each other by a
             dashed (non-reporting) line rather than a solid one.
        ================================================================== -->
        <record id="module_category_mzr_global" model="ir.module.category">
            <field name="name">Mazenet Access Rights: Global</field>
            <field name="description">Company-wide roles that span every Mazenet team (DMT, Technology, software, MIS, and the Corporate BU).</field>
            <field name="sequence">5</field>
        </record>
        <record id="res_groups_privilege_mzr_global" model="res.groups.privilege">
            <field name="name">Global Role</field>
            <field name="category_id" ref="module_category_mzr_global"/>
            <field name="sequence">1</field>
        </record>

        <!-- CTO / Admin: full write access, implies every team's BU Manager
             group (and therefore, transitively, every team's whole chain),
             plus the single shared Corporate BU Manager. -->
        <record id="group_mzr_cto_admin" model="res.groups">
            <field name="name">CTO / Admin (All Teams)</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_global"/>
            <field name="implied_ids" eval="[
                (4, ref('group_mzr_dmt_manager')),
                (4, ref('group_mzr_technology_manager')),
                (4, ref('group_mzr_software_manager')),
                (4, ref('group_mzr_mis_manager')),
                (4, ref('group_mzr_corporate_manager')),
            ]"/>
            <field name="comment">Full access across DMT, Technology, software, MIS and the Corporate BU (Hunter, Account Manager, Corporate Training, LMS, TNH). The single company-wide "All access" role from the org chart - not duplicated per team.</field>
        </record>

        <!-- MD: read-only oversight of all teams. Deliberately does NOT
             imply any team's write-capable chain (mirrors the dashed,
             non-reporting-line relationship to CTO/admin in the org chart);
             wire this group into read-only ir.rule domains (no team filter)
             when record-level rules are added later. -->
        <record id="group_mzr_md" model="res.groups">
            <field name="name">MD (Read-Only, All Teams)</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_global"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read-only oversight across DMT, Technology, software and MIS. Not part of the write-access chain of any team (parallel role, not a reporting line) - grant it read access via ir.rule, not implied_ids, when wiring up models.</field>
        </record>

    </data>
</odoo>
