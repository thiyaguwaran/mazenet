<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- =================================================================
             DMT team - isolated hierarchy below CTO/Admin & MD.
             Chain: Agent -> ATL -> Team Lead -> BU Manager
             (BU Manager is then implied by the single, global CTO/Admin
             group at the bottom of this file - see the Global section.)
             None of these 4 groups are implied by / imply any other team's
             groups.
        ================================================================== -->
        <record id="module_category_mzr_dmt" model="ir.module.category">
            <field name="name">Mazenet Access Rights: DMT</field>
            <field name="description">Isolated access hierarchy for the DMT team only.</field>
            <field name="sequence">10</field>
        </record>
        <record id="res_groups_privilege_mzr_dmt" model="res.groups.privilege">
            <field name="name">DMT Role</field>
            <field name="category_id" ref="module_category_mzr_dmt"/>
            <field name="sequence">1</field>
        </record>

        
        <record id="group_mzr_dmt_agent" model="res.groups">
            <field name="name">DMT: Agent</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_dmt"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">ATL-supervised front-line agent on the DMT team only. No visibility into other teams.</field>
        </record>
        <record id="group_mzr_dmt_atl" model="res.groups">
            <field name="name">DMT: ATL</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_dmt"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_dmt_agent'))]"/>
            <field name="comment">Assistant Team Lead on the DMT team only. Supervises a small group of agents.</field>
        </record>



        <record id="group_mzr_dmt_tl_direct_agent" model="res.groups">
            <field name="name">DMT: TL-Direct Agent</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_dmt"/>
            <!-- <field name="implied_ids" eval="[(4, ref('group_mzr_dmt_agent'))]"/> -->
            <field name="comment">This is the TL-Direct Agent group for the DMT team.</field>
        </record>
        <record id="group_mzr_dmt_tl" model="res.groups">
            <field name="name">DMT: Team Lead</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_dmt"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_dmt_atl')),
                                            (4, ref('group_mzr_dmt_tl_direct_agent')),]"/>
            <field name="comment">Team Lead on the DMT team only. Supervises ATLs plus any directly-assigned agents ("TL-direct").</field>
        </record>
        <record id="group_mzr_dmt_manager_direct_agent" model="res.groups">
            <field name="name">DMT: Manager-Direct Agent</field>
            <field name="sequence">35</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_dmt"/>
            <!-- <field name="implied_ids" eval="[(4, ref('group_mzr_dmt_agent'))]"/> -->
            <field name="comment">This is the Manager-Direct Agent group for the DMT team.</field>
        </record>

        <record id="group_mzr_dmt_manager" model="res.groups">
            <field name="name">DMT: BU Manager</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_mzr_dmt"/>
            <field name="implied_ids" eval="[(4, ref('group_mzr_dmt_tl')),
                                            (4, ref('group_mzr_dmt_manager_direct_agent')),]"/>
            <field name="comment">Business Unit Manager for the DMT team only. Oversees the Team Lead branch plus any directly-assigned agents ("Manager-direct"). One per team. Implied by the global CTO/Admin group.</field>
        </record>

