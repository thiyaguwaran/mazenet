        </record>
        <record id="stage_corp_needs" model="crm.stage">
            <field name="name">Needs Analysis</field>
            <field name="sequence">3</field>
            <field name="team_ids" eval="[(4, ref('team_corporate')), (4, ref('team_corporate')), (4, ref('team_corporate'))]"/>
        </record>
        <record id="stage_corp_proposal" model="crm.stage">
            <field name="name">Proposal / Quote</field>
            <field name="sequence">4</field>
            <field name="team_ids" eval="[(4, ref('team_corporate')), (4, ref('team_corporate')), (4, ref('team_corporate'))]"/>
        </record>
        <record id="stage_corp_negotiation" model="crm.stage">
