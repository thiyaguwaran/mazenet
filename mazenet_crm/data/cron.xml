<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Section 7.6 (M2): auto-trigger the RED lock on overdue leads. -->
        <record id="ir_cron_mz_trigger_red_locks" model="ir.cron">
            <field name="name">Mazenet CRM: Trigger &amp; Escalate RED Locks on Overdue Leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_trigger_red_locks()
model.check_red_lock_recods()</field>
            <!-- 2 minutes for active dev/UAT testing so lock/notify behavior is visible
                 almost immediately. Widen this back out (e.g. 15 min) before anything
                 resembling a production/staging cadence - a 2-minute poll isn't meant to
                 run long-term at scale. -->
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Client rework spec (2026-09-08): the Pipeline kanban card must repaint
             (purple -> green -> red) purely because time has passed, even when nothing on
             the lead was written - x_activity_card_state is a STORED field precisely so it
             can drive the card's CSS class, but that also means it needs an explicit
             periodic recompute; a plain @api.depends alone only re-fires on a write.
             Scoped inside the method itself to leads whose activity falls within a day of
             now, in DMT/Tally/Technology only - NOT a full-table sweep. 5 minutes is short
             enough that the green window (+/-20 min) and the day-rolls-over-to-"today"
             purple transition are never stale for long. -->
        <record id="ir_cron_mz_recompute_activity_card_state" model="ir.cron">
            <field name="name">Mazenet CRM: Recompute Activity Card State (Purple/Green/Red)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_activity_card_state()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- LMS Pipeline Stage 7 (Mazenet_CRM_Corporate_LMS_TNH_Pipelines.xlsx, Build
             Notes #6): the project's only cron. Runs DAILY, nextcall pinned to 20:00
             IST (14:30 UTC) - the method itself (_cron_lms_friday_escalation) is what
             actually restricts escalation to Fridays, checked in IST; see its own
             docstring for why a daily interval was used instead of trying to express
             a weekly-on-Friday cadence directly in interval_type. -->
        <record id="ir_cron_mz_lms_friday_escalation" model="ir.cron">
            <field name="name">Mazenet CRM: LMS Friday Escalation (KT / Skill Upload)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_lms_friday_escalation()</field>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d') + ' 14:30:00'"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
