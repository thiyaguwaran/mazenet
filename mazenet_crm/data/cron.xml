<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Section 7.6 (M2): auto-trigger the RED lock on overdue leads. -->
        <record id="ir_cron_mz_trigger_red_locks" model="ir.cron">
            <field name="name">Mazenet CRM: Trigger RED Locks on Overdue Leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_trigger_red_locks()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Section 5 Fallback 2: 24h auto-escalation for unreleased locks. -->
        <record id="ir_cron_mz_escalate_red_locks" model="ir.cron">
            <field name="name">Mazenet CRM: Escalate RED Locks Unreleased 24h+</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_red_locks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
