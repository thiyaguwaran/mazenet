<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="team_dmt" model="crm.team">
            <field name="name">DMT</field>
            <field name="x_bu_category">dmt</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_corporate" model="crm.team">
            <field name="name">Corporate</field>
            <field name="x_bu_category">corp</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <!-- Corporate Pipeline build (Mazenet_CRM_Corporate_LMS_TNH_Pipelines.xlsx): split
             3 of team_corporate's 5 former sub-teams out into their own real crm.team
             records, per Build Notes #1 ("one stage set shared by three teams is not
             natively possible - build three identical stage sets, one each for Hunter,
             Account Manager and Corporate Training, with team_id set on each") and #4
             (rename the new 4th team to avoid the "Corporate Training" name collision
             with the BU umbrella term). LMS and TNH stay on team_corporate until their
             own build turns - see data/stages.xml and security/record_rules.xml. -->
        <record id="team_hunter" model="crm.team">
            <field name="name">Hunter</field>
            <field name="x_bu_category">corp_hunter</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_account_manager" model="crm.team">
            <field name="name">Account Manager</field>
            <field name="x_bu_category">corp_am</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_corp_training_delivery" model="crm.team">
            <field name="name">Corp Training Delivery</field>
            <field name="x_bu_category">corp_training</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <!-- LMS Pipeline build (Mazenet_CRM_Corporate_LMS_TNH_Pipelines.xlsx): split LMS
             out of team_corporate the same way as Hunter/AM/Corp Training Delivery above.
             TNH stays on team_corporate until its own build turn. -->
        <record id="team_lms" model="crm.team">
            <field name="name">LMS</field>
            <field name="x_bu_category">lms</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <!-- TNH Pipeline build (Mazenet_CRM_Corporate_LMS_TNH_Pipelines.xlsx): the last of
             team_corporate's original 5 sub-teams to split out. Once this lands,
             team_corporate holds only corp_mgr + their own direct-report agents - see
             record_rules.xml's corporate_manager_direct rule, updated to no longer
             need team_corporate in its domain either. -->
        <record id="team_tnh" model="crm.team">
            <field name="name">TNH</field>
            <field name="x_bu_category">tnh</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_tally" model="crm.team">
            <field name="name">Tally</field>
            <field name="x_bu_category">tally</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_technology" model="crm.team">
            <field name="name">Technology</field>
            <field name="x_bu_category">tech</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_software" model="crm.team">
            <field name="name">Software</field>
            <field name="x_bu_category">swdev</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
        <record id="team_mis" model="crm.team">
            <field name="name">MIS</field>
            <field name="x_bu_category">mis</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>
    </data>
</odoo>
