<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Replaces the separate Due Date + Time fields with a single combined datetime
             picker for Call / To-Do / Email activities, the same way a Meeting is scheduled
             as one step (date+time picked together on the calendar event form) rather than
             two. date_deadline stays in the view (hidden) since it's the field the wizard's
             own compute/default logic and Odoo core both key off internally - only what's
             shown to the user changes. -->
        <record id="mail_activity_schedule_view_form_inherit_mz" model="ir.ui.view">
            <field name="name">mail.activity.schedule.form.inherit.mz</field>
            <field name="model">mail.activity.schedule</field>
            <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_deadline']" position="after">
                    <field name="mz_activity_datetime" string="Scheduled For"
                           invisible="activity_category == 'meeting'"/>
                </xpath>
            </field>
        </record>

        <!-- Same field, on the popup used to edit/reschedule an EXISTING activity (clicking
             an activity chip in the chatter) - the schedule wizard above only covers
             creation. -->
        <record id="mail_activity_view_form_popup_inherit_mz" model="ir.ui.view">
            <field name="name">mail.activity.view.form.popup.inherit.mz</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_deadline']" position="after">
                    <field name="mz_activity_datetime" string="Scheduled For"
                           invisible="activity_category == 'meeting'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
