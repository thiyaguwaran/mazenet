<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mz_lead_spinoff_wizard_form" model="ir.ui.view">
            <field name="name">mz.lead.spinoff.wizard.form</field>
            <field name="model">mz.lead.spinoff.wizard</field>
            <field name="arch" type="xml">
                <form string="Create New Opportunity">
                    <field name="source_lead_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="contact_name"/>
                            <field name="function"/>
                            <field name="email_from"/>
                            <field name="email_cc" groups="base.group_no_one"/>
                            <field name="phone"/>
                            <field name="website"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group string="Route To">
                        <field name="team_id"/>
                    </group>
                    <!-- Marketing section removed from the view (client instruction,
                         2026-09-13) - campaign_id/medium_id/source_id/referred/
                         company_id/lang_id are still copied over from the source lead
                         automatically (DETAIL_FIELDS in lead_spinoff_wizard.py), just
                         no longer shown/editable on this wizard. -->
                    <field name="campaign_id" invisible="1"/>
                    <field name="medium_id" invisible="1"/>
                    <field name="source_id" invisible="1"/>
                    <field name="referred" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="lang_id" invisible="1"/>
                    <group>
                        <field name="description" nolabel="1" placeholder="What are they asking for this time?"/>
                    </group>
                    <footer>
                        <button name="action_create_lead" string="Create" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_mz_lead_spinoff_wizard" model="ir.actions.act_window">
            <field name="name">Create New Opportunity</field>
            <field name="res_model">mz.lead.spinoff.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
