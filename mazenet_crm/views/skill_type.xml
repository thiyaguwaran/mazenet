<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_skill_type_list" model="ir.ui.view">
        <field name="name">skill.type.list</field>
        <field name="model">skill.type</field>
        <field name="arch" type="xml">
            <list string="Buisiness Units" editable="bottom" create="0">
                <field name="name"/>
                <field name="short_name"/>
                <field name="team_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="company_id" optional="hide" readonly="1"/>
                <button name="action_open_form" type="object"
                        icon="fa-external-link" title="Open"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_skill_type_form" model="ir.ui.view">
        <field name="name">skill.type.form</field>
        <field name="model">skill.type</field>
        <field name="arch" type="xml">
            <form string="Buisiness Unit">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="short_name"/>
                            <field name="bu_id"/>
                        </group>
                        <group>
                            <field name="team_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Business Services" name="business_services">
                            <field name="business_service_ids">
                                <list editable="bottom">
                                    <field name="maze_id"/>
                                    <field name="services"/>
                                    <field name="shortname"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_skill_type" model="ir.actions.act_window">
        <field name="name">Buisiness Unit</field>
        <field name="res_model">skill.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a model to restrict
            </p>
            <p>
                Create Buisiness Unit
            </p>
        </field>
    </record>

    <menuitem id="menu_skill_type_main"
              name="Buisiness Unit"
              parent="crm.crm_menu_config"
              action="action_skill_type"
              sequence="100"/>

</odoo>
