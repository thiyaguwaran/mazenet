<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_team_form_inherit_mz" model="ir.ui.view">
            <field name="name">crm.team.form.inherit.mz</field>
            <field name="model">crm.team</field>
            <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="x_bu_category"/>
                    <field name="create_lead_id" string="Create Lead To" widget="many2many_tags"/>
                    <field name="privelege_ids" string="Privileges" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
