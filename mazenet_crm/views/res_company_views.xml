<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.company form -->
    <record id="view_res_company_form_inherit" model="ir.ui.view">
        <field name="name">view.res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='branches']" position="after">
                <page string="CRM Settings">
                    <group>
                        <field name="grace_time"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>