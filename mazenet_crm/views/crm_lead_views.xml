<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Lead Form View Inheritance -->
        <record id="view_crm_lead_form_inherit_mz" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.mz</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- Release button lives in the header, next to the (now hidden-while-locked)
                     stage statusbar and Won/Lost/Convert buttons - see below. -->
                <xpath expr="//header" position="inside">
                    <button name="action_release_lock" string="Release RED Lock" type="object"
                            class="btn-danger" invisible="not x_is_locked"
                            confirm="Release the RED lock on this lead? It will become editable again."/>
                </xpath>

                <xpath expr="//sheet" position="attributes">
                    <attribute name="readonly">x_content_readonly_for_me</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="readonly">(x_content_readonly_for_me and not x_is_dmt_user) or x_assign_type == 'self'</attribute>
                    <attribute name="domain">[('id', 'in', x_assignable_user_ids)]</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="x_assign_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="team_id" readonly="x_assign_type == 'self'" required="x_assign_type != 'self'"/>
                    <field name="x_can_assign_beyond_self" invisible="1"/>
                    <field name="x_assignable_user_ids" invisible="1"/>
                    <field name="x_is_dmt_user" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='stage_id']" position="attributes">
                    <attribute name="readonly">won_status == 'lost' or not active or x_content_readonly_for_me</attribute>
                </xpath>
                <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                    <attribute name="invisible" add="x_content_readonly_for_me" separator="or"/>
                </xpath>
                <xpath expr="//button[@name='%(crm.action_crm_lead2opportunity_partner)d']" position="attributes">
                    <attribute name="invisible" add="x_content_readonly_for_me" separator="or"/>
                </xpath>
                <xpath expr="//button[@name='action_restore']" position="attributes">
                    <attribute name="invisible" add="x_content_readonly_for_me" separator="or"/>
                </xpath>
                <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                    <attribute name="invisible" add="x_content_readonly_for_me" separator="or"/>
                </xpath>

                <xpath expr="//field[@name='won_status']" position="before">
                    <field name="x_is_locked" invisible="1"/>
                    <field name="x_content_readonly_for_me" invisible="1"/>
                    <field name="x_team_transfer_readonly" invisible="1"/>
                    <div class="alert alert-danger mb-0" role="alert" invisible="not x_is_locked">
                        <i class="fa fa-lock me-1" title="RED Lock"/>
                        <b>RED LOCKED</b> - this lead is overdue and read-only until released.
                    </div>
                    <div class="alert alert-secondary mb-0" role="alert" invisible="not x_team_transfer_readonly">
                        <i class="fa fa-arrow-right-arrow-left me-1" title="Transferred"/>
                        <b>TRANSFERRED</b> - this lead has moved to another Sales Team and is read-only for you.
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Lead Kanban View Inheritance for RED Color Cards -->
        <record id="view_crm_lead_kanban_inherit_mz" model="ir.ui.view">
            <field name="name">crm.lead.kanban.inherit.mz</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="inside">
                    <field name="x_is_locked"/>
                    <field name="activity_state"/>
                    <field name="x_activity_warning"/>
                    <field name="x_team_transfer_readonly"/>
                </xpath>
                <xpath expr="//t[@t-name='card']/*[1]" position="before">
                    <!-- Small corner ribbon + a subtle tint/border (via kanban_red.css, keyed off
                         the .mz-red-locked-card marker) - the card's own content stays visible.
                         A previous version covered the whole card with a solid red block; that
                         read as too aggressive for a simple overdue/locked indicator. -->
                    <widget name="web_ribbon" id="mz_red_lock_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not x_is_locked and activity_state != 'overdue'"/>
                    <span t-if="record.x_is_locked.raw_value or record.activity_state.raw_value == 'overdue'" class="mz-red-locked-card d-none"/>
                    <!-- Pre-lock warnings (see crm_lead.py x_activity_warning): purple in the
                         30-min window before the next activity, orange in the 10-min window -
                         already scoped server-side to just the owner/attendees, so no extra
                         invisible condition needed here beyond the field's own value. -->
                    <span t-if="record.x_activity_warning.raw_value == 'purple'" class="mz-activity-purple-card d-none"/>
                    <span t-if="record.x_activity_warning.raw_value == 'orange'" class="mz-activity-orange-card d-none"/>
                    <!-- Read-only because Sales Team moved off whoever's browsing (not a
                         RED lock - that already gets the red treatment above) - grey tint,
                         same marker-span pattern, see kanban_red.css. -->
                    <span t-if="record.x_team_transfer_readonly.raw_value" class="mz-team-transferred-card d-none"/>
                </xpath>
            </field>
        </record>

        <!-- Kanban Quick-Create Form: show Sales Team, defaulted to the creating user's
             own team (crm_lead.py _mz_default_team_id) - stock CRM ships this field but
             keeps it invisible="1". Since write() now requires being a member of a
             lead's CURRENT team_id to touch it at all, whatever team_id a lead gets
             created with has to be right from the start; surfacing the field here lets
             the creator see/confirm/correct it (e.g. TL/ATL/Manager assigning straight
             to a different team) instead of it being an invisible, silent default. -->
        <record id="view_crm_lead_quick_create_inherit_mz" model="ir.ui.view">
            <field name="name">crm.lead.form.quick_create.inherit.mz</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='team_id']" position="replace">
                    <div class="d-flex align-items-center" colspan="2">
                        <i class="fa fa-users" title="Sales Team"/>
                        <field name="team_id" nolabel="1" class="o_field_highlight w-100 mb-0"
                               options="{'no_create': True}"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
