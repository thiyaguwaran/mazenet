<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Rows: Team -> Stage -> Salesperson (stage nested under team since
             each team has its own distinct stage set - see
             crm_lead_pivot_views.xml's own comment on the same point).
             Columns: month, for a trend view. Measures: Count first (the
             primary ask - "how much lead count against the salesperson each
             stage"), Expected Revenue second. No type="measure" field is
             declared in the arch itself - see crm_lead_pivot_views.xml's
             comment on why that would suppress Count as the default; the
             measures are set via the action's context below instead. -->
        <record id="crm_lead_report_view_pivot" model="ir.ui.view">
            <field name="name">crm.lead.report.pivot</field>
            <field name="model">crm.lead.report</field>
            <field name="arch" type="xml">
                <pivot string="Lead Report (Team → Stage → Salesperson, by Month)" sample="1">
                    <field name="team_id" type="row"/>
                    <field name="stage_id" type="row"/>
                    <field name="user_id" type="row"/>
                    <field name="create_date" interval="month" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- Drill-down target for the pivot above (clicking a cell opens this list of
             the actual leads behind that count/measure) - needs name + partner_id to be
             useful for identifying which leads, not just the aggregate fields. -->
        <record id="crm_lead_report_view_list" model="ir.ui.view">
            <field name="name">crm.lead.report.list</field>
            <field name="model">crm.lead.report</field>
            <field name="arch" type="xml">
                <list string="Leads" create="0" edit="0" delete="0">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="team_id"/>
                    <field name="stage_id"/>
                    <field name="type"/>
                    <field name="priority" optional="hide"/>
                    <field name="expected_revenue" sum="Total"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="crm_lead_report_view_graph" model="ir.ui.view">
            <field name="name">crm.lead.report.graph</field>
            <field name="model">crm.lead.report</field>
            <field name="arch" type="xml">
                <graph string="Lead Report" type="bar" sample="1">
                    <field name="team_id"/>
                    <field name="stage_id"/>
                </graph>
            </field>
        </record>

        <record id="crm_lead_report_view_search" model="ir.ui.view">
            <field name="name">crm.lead.report.search</field>
            <field name="model">crm.lead.report</field>
            <field name="arch" type="xml">
                <search string="Lead Report Search">
                    <field name="user_id"/>
                    <field name="team_id"/>
                    <field name="stage_id"/>
                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Salesperson" name="group_by_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                        <filter string="Sales Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="crm_lead_report_action" model="ir.actions.act_window">
            <field name="name">Lead Report</field>
            <field name="res_model">crm.lead.report</field>
            <field name="view_mode">pivot,list,graph</field>
            <field name="search_view_id" ref="crm_lead_report_view_search"/>
            <field name="context">{
                'search_default_filter_active': 1,
                'pivot_measures': ['__count', 'expected_revenue'],
            }</field>
        </record>

        <menuitem id="menu_crm_lead_report"
                  name="Lead Report"
                  parent="crm.crm_menu_report"
                  action="crm_lead_report_action"
                  sequence="5"/>

    </data>
</odoo>
