<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Upload date/time and uploader under the file name. Only attachments loaded by mz_many2many_binary carry
     create_date, so the stock many2many_binary fields elsewhere are unaffected. -->
<t t-inherit="web.Many2ManyBinaryField.attachment_preview" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('caption')]" position="after">
        <div t-if="file.create_date" class="caption small text-muted">
            <i class="fa fa-clock-o me-1"/><t t-out="formatUploadedAt(file)"/>
        </div>
        <div t-if="uploadedBy(file)" class="caption small text-muted">
            <i class="fa fa-user-o me-1"/><t t-out="uploadedBy(file)"/>
        </div>
    </xpath>
    <!-- Delete (x) button on mz_many2many_binary only for CTO / Admin (canRemove); stock many2many_binary has no canRemove, so it keeps its button. -->
    <xpath expr="//div[hasclass('o_attachment_delete')]" position="attributes">
        <attribute name="t-if">editable and canRemove !== false</attribute>
    </xpath>
</t>

</templates>
