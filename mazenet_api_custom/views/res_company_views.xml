<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_api_config" model="ir.ui.view">
        <field name="name">res.company.form.api.config</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@id='company_currency']" position="after">
                <field name="allow_api_config_edit" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
