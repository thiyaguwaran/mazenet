<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Work order button and result next to the Business Service field of the lead (one common field for every team) -->
    <record id="view_crm_lead_form_work_order" model="ir.ui.view">
        <field name="name">crm.lead.form.work.order</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="mazenet_crm.view_crm_lead_form_inherit_mz"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='business_service_id'])[1]" position="after">
                <button name="action_create_work_order" type="object" string="Create Work Order"
                        class="btn-secondary"
                        invisible="won_status != 'won' or not skill_type_id or not business_service_id or maze_query_id"/>
                <!-- <field name="work_order_id" invisible="not work_order_id"/> -->
                <field name="maze_query_id" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="maze_wo_no" invisible="won_status != 'won' or not maze_wo_no"/>
                <field name="work_order_url" widget="url" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <!-- Work Start / End Date inside every "Stage 6 - Project State" block (one per team
                 group in the parent view, so one xpath for each occurrence) -->
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[1]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[2]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[3]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[4]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[5]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[6]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[7]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[8]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
            <xpath expr="(//field[@name='x_project_start_attachment_ids'])[9]" position="before">
                <field name="work_start_date" invisible="won_status != 'won' or not maze_query_id"/>
                <field name="work_end_date" invisible="won_status != 'won' or not maze_query_id"/>
            </xpath>
        </field>
    </record>
</odoo>
