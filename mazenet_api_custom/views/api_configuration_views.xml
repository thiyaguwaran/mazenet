<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_api_configuration_list" model="ir.ui.view">
        <field name="name">api.configuration.list</field>
        <field name="model">api.configuration</field>
        <field name="arch" type="xml">
            <list string="API Configuration">
                <field name="name"/>
                <field name="api_type"/>
                <field name="route"/>
                <field name="http_method" widget="badge"/>
                <field name="operation_type" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'" decoration-danger="state == 'failed'"/>
                <field name="last_sync" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_api_configuration_form" model="ir.ui.view">
        <field name="name">api.configuration.form</field>
        <field name="model">api.configuration</field>
        <field name="arch" type="xml">
            <form string="API Configuration">
                <header>
                    <button name="sync_data" string="Sync" type="object" class="btn-primary"
                            invisible="api_type in ('create_work_order', 'fetch_dates')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,success,failed"/>
                </header>
                <sheet>  
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Create CRM lead"/></h1>
                    </div>
                    <group>
                        <group string="Endpoint">
                            <field name="api_type" placeholder="Select the Direction type...."/>
                            <field name="server_id" placeholder="Select the Server...."
                                   invisible="api_type == 'fetch_dates'"
                                   required="api_type != 'fetch_dates'"/>
                            <field name="route" placeholder="/api/v1/leads"/>
                            <field name="payload" placeholder="Paste a valid json data !!!"
                                   invisible="api_type == 'fetch_dates'"/>
                            <field name="incoming_url" widget="CopyClipboardChar"
                                   invisible="api_type != 'fetch_dates'"/>
                            <label for="incoming_token" invisible="api_type != 'fetch_dates'"/>
                            <div class="o_row" invisible="api_type != 'fetch_dates'">
                                <field name="incoming_token" widget="CopyClipboardChar"
                                       required="api_type == 'fetch_dates'"/>
                                <button name="action_generate_token" type="object"
                                        string="Generate" class="btn-secondary"/>
                            </div>
                        </group>
                        <group string="Request">
                            <field name="http_method"/>
                            <field name="operation_type" invisible="api_type == 'fetch_dates'"/>
                            <field name="save_in" invisible="api_type in ('buisiness_services', 'fetch_dates')"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Last sync" invisible="state == 'draft'">
                        <field name="last_sync"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_api_configuration_search" model="ir.ui.view">
        <field name="name">api.configuration.search</field>
        <field name="model">api.configuration</field>
        <field name="arch" type="xml">
            <search string="API Configuration">
                <field name="name"/>
                <field name="route"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_http_method" string="HTTP Method" context="{'group_by': 'http_method'}"/>
                    <filter name="group_operation_type" string="Operation Type" context="{'group_by': 'operation_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_configuration" model="ir.actions.act_window">
        <field name="name">API Configuration</field>
        <field name="res_model">api.configuration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure your first API</p>
            <p>Define the route, HTTP method and operation of each API.</p>
        </field>
    </record>

    <!-- Menu: separate top-level "API" menu -->
    <menuitem id="menu_api_root" name="API" sequence="95" groups="base.group_system"/>
    <menuitem id="menu_api_configuration" name="API Configuration" parent="menu_api_root"
              action="action_api_configuration" sequence="10"/>

</odoo>
