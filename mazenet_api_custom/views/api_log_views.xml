<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_api_log_list" model="ir.ui.view">
        <field name="name">api.log.list</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <list string="API Logs" create="0" edit="0"
                  decoration-success="status == 'success'" decoration-danger="status == 'failed'">
                <field name="create_date" string="Date"/>
                <field name="configuration_id"/>
                <field name="server_id" optional="show"/>
                <field name="direction" widget="badge"/>
                <field name="http_method"/>
                <field name="url" optional="show"/>
                <field name="response_code"/>
                <field name="response_body"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                <field name="duration" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form (read only) -->
    <record id="view_api_log_form" model="ir.ui.view">
        <field name="name">api.log.form</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <form string="API Log" create="0" edit="0" delete="1">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="create_date" string="Date"/>
                            <field name="direction"/>
                            <field name="http_method"/>
                            <field name="url"/>
                            <field name="configuration_id"/>
                            <field name="server_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Result">
                            <field name="response_code"/>
                            <field name="duration"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <group>
                        <group string="Request Body">
                            <field name="request_body" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Response Body">
                            <field name="response_body" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <group string="Request Headers (secrets are hidden)">
                        <field name="request_headers" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_api_log_search" model="ir.ui.view">
        <field name="name">api.log.search</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <search string="API Logs">
                <field name="name" string="Request"/>
                <field name="configuration_id"/>
                <field name="server_id"/>
                <field name="url"/>
                <filter name="filter_success" string="Success" domain="[('status', '=', 'success')]"/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="filter_outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <filter name="filter_incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_configuration" string="API" context="{'group_by': 'configuration_id'}"/>
                    <filter name="group_server" string="Server" context="{'group_by': 'server_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">api.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No API transaction yet</p>
            <p>Every call made to or received from another system is recorded here.</p>
        </field>
    </record>

    <!-- Menu: inside the API menu -->
    <menuitem id="menu_api_log" name="API Logs" parent="menu_api_root"
              action="action_api_log" sequence="30"/>

</odoo>
